# Copiez ce fichier en .env (sur le serveur : /srv/livres/.env, permissions 600).
# Ne mettez JAMAIS ce fichier sur GitHub.

# Clé secrète (obligatoire en production). Générez-la avec :  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplacez-par-une-longue-valeur-aleatoire

# Base PostgreSQL : postgresql://UTILISATEUR:MOT_DE_PASSE@HÔTE:5432/NOM_BASE
# (mot de passe sans caractères spéciaux : lettres et chiffres uniquement)
DATABASE_URL=postgresql://livres:MOT_DE_PASSE@localhost:5432/livres

# Production derrière HTTPS uniquement (sinon la connexion ne marchera pas) :
COOKIE_SECURE=1
# Derrière Nginx (lit X-Forwarded-*) :
TRUST_PROXY=1
