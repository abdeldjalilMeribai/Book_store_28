# Copiez ce fichier en .env (ou définissez ces variables sur votre hébergeur).
# Si SECRET_KEY est absente, une clé aléatoire est créée dans instance/secret_key au premier lancement.
SECRET_KEY=remplacez-par-une-longue-valeur-aleatoire
# En production derrière HTTPS :
COOKIE_SECURE=1
# Si vous êtes derrière Nginx / Render / Railway (lit X-Forwarded-*) :
TRUST_PROXY=1
# Chemin de la base SQLite (par défaut instance/boutique.db). Sur un hébergeur, pointez vers un disque persistant :
# DATABASE_PATH=/data/boutique.db
