[Unit]
Description=Librairie 0,00 28 (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=livres
Group=livres
WorkingDirectory=/srv/livres
EnvironmentFile=/srv/livres/.env
ExecStart=/srv/livres/.venv/bin/gunicorn app:app --workers 3 --threads 4 --timeout 60 --bind 127.0.0.1:8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
